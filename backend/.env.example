# Astra Multi - spike config example
# Copy to .env and fill in values. Do NOT commit .env.

# Provider API keys (only needed for P0.4 live smoke test)
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...

# Model configuration per role (defaults for spike)
PLANNER_PROVIDER=fake
PLANNER_MODEL=fake-model
REVIEWER_PROVIDER=fake
REVIEWER_MODEL=fake-model
SYNTHESIZER_PROVIDER=fake
SYNTHESIZER_MODEL=fake-model

# Budget limits (spike defaults)
MAX_ROUNDS=2
MAX_CONCURRENT_LLM=2
CALL_TIMEOUT_SECONDS=120
MAX_RETRIES=2
